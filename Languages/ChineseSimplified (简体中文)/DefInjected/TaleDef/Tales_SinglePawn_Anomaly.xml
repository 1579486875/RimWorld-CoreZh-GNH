<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: closed the void node -->
  <ClosedTheVoid.label>已关闭虚空节点</ClosedTheVoid.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef]关闭了虚空节点。</li>
    <li>image->[PAWN_nameFull]封上了通往虚空的连接，确保了殖民地的安全，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]倔然立于虚空节点之前，决心守护殖民地，[circumstance_group]</li>
    <li>circumstance_phrase->在噼啪作响的能量之中</li>
    <li>circumstance_phrase->虚空节点散发着萦绕不散的光</li>
    <li>circumstance_phrase->虚空在背景中低语</li>
    <li>desc_sentence->灰色金属从四面逼近。</li>
    <li>desc_sentence->其他殖民者出现在[side_position]，焦急地等待[PAWN_nameDef]归来。</li>
    <li>desc_sentence->[PAWN_nameDef]的表情透露出[PAWN_pronoun]正在为眼前的抉择而痛苦。</li>
  -->
  <ClosedTheVoid.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef]正在关闭虚空节点。</li>
    <li>image->[PAWN_nameFull][circumstance_group]，正在关闭与虚空的链接，以确保殖民地的安全</li>
    <li>image->[PAWN_nameFull][circumstance_group]，不屑地站在虚空节点前，决心保护殖民地</li>
    <li>circumstance_phrase->伴随着心灵能量噼啪作响</li>
    <li>circumstance_phrase->虚空节点散发出一阵强烈的光芒</li>
    <li>circumstance_phrase->身后似有虚空在低语</li>
    <li>desc_sentence->灰暗的金属从四面八方压迫而来。</li>
    <li>desc_sentence->其他殖民者在[side_position]的方向。焦急地等待[PAWN_nameDef]的归来。</li>
    <li>desc_sentence->[PAWN_nameDef]的表情暴露了[PAWN_pronoun]正在为眼前的选择而苦恼。</li>
  </ClosedTheVoid.rulePack.rulesStrings>
  
  <!-- EN: embraced the void -->
  <EmbracedTheVoid.label>拥抱虚空</EmbracedTheVoid.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef]拥抱虚空</li>
    <li>image->[PAWN_nameFull]驾驭着虚空的禁忌知识，超越了凡俗的局限，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]向虚空的诱惑投降，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]屈服于虚空那不祥的低语，[circumstance_group]</li>
    <li>circumstance_phrase->黑暗能量的触须盘绕在[PAWN_possessive]肢体上</li>
    <li>circumstance_phrase->在旋转的能量漩涡之中</li>
    <li>circumstance_phrase->带着令人不安的微笑</li>
    <li>desc_sentence->[PAWN_nameDef]散发着不祥的力量，那是[PAWN_possessive]与虚空立约的明证。</li>
    <li>desc_sentence->[PAWN_nameDef]的双眼开始泛起异界的光。</li>
    <li>desc_sentence->其他殖民者出现在[side_position]，质疑[PAWN_nameDef]这一选择是否明智。</li>
  -->
  <EmbracedTheVoid.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef]正拥抱虚空</li>
    <li>image->[PAWN_nameFull]利用虚空的禁忌知识，超脱凡人的局限性，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]在虚空的诱惑下沉沦，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]屈服于虚空的邪恶低语，[circumstance_group]</li>
    <li>circumstance_phrase->[PAWN_possessive]四肢被暗黑能量的卷须缠绕着</li>
    <li>circumstance_phrase->深陷于心灵漩涡之中</li>
    <li>circumstance_phrase->面上还带着诡异的微笑</li>
    <li>desc_sentence->[PAWN_nameDef]浑身散发出一种不祥的力量，正是虚空与[PAWN_possessive]契约。</li>
    <li>desc_sentence->[PAWN_nameDef]的眼睛开始闪烁着超凡的光芒。</li>
    <li>desc_sentence->其他殖民者正在[side_position]的方向，质疑[PAWN_nameDef]的选择是否明智。</li>
  </EmbracedTheVoid.rulePack.rulesStrings>
  
  <!-- EN: performed a psychic ritual -->
  <PerformedPsychicRitual.label>举行心灵仪式</PerformedPsychicRitual.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef]主持灵能仪式</li>
    <li>image->[PAWN_nameFull]引导着在[PAWN_objective]周身舞动的能量，编织着一场强大的灵能仪式，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]念诵着黑暗的咒文，勾动神秘的力量来施行灵能仪式，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]凝神注视，施行着一场灵能仪式，[circumstance_group]</li>
    <li>image->[PAWN_nameFull]在空气中勾勒繁复的符号，驾驭潜藏的能量以显化灵能仪式，[circumstance_group]</li>
    <li>circumstance_phrase->专注地盯着[PAWN_objective]面前的书卷</li>
    <li>circumstance_phrase->神情专注而坚定，尽显[PAWN_possessive]对灵能技艺的精通</li>
    <li>circumstance_phrase->带着残忍的微笑</li>
    <li>circumstance_phrase->[PAWN_possessive]声音竭力压过能量的轰鸣</li>
    <li>desc_sentence->颂唱者们出现在[side_position]，给予支持。</li>
    <li>desc_sentence->[PAWN_nameDef]完成灵能仪式时，空气随之颤动。</li>
    <li>desc_sentence->独石在背景中微微闪烁。</li>
    <li>desc_sentence->四周的蜡烛在旋转的能量中明灭作响。</li>
  -->
  <PerformedPsychicRitual.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef]正主持心灵仪式</li>
    <li>image->[PAWN_nameFull][circumstance_group]，引导在自身周围跳动的能量，同时编织着这一强大的心灵仪式</li>
    <li>image->[PAWN_nameFull][circumstance_group]，念诵暗黑咒语，借助神秘力量举行心灵仪式</li>
    <li>image->[PAWN_nameFull][circumstance_group]，聚精会神地进行心灵仪式</li>
    <li>image->[PAWN_nameFull][circumstance_group]，在空气中描画着复杂的符号，利用潜在的心灵能量来展现心灵仪式</li>
    <li>circumstance_phrase->集中于面前的咒术书</li>
    <li>circumstance_phrase->以专注的决心，展示[PAWN_pronoun]对心灵之术的精通</li>
    <li>circumstance_phrase->面上带着一丝残忍的笑意</li>
    <li>circumstance_phrase->的声音透过能量的轰鸣声奋力呐喊</li>
    <li>desc_sentence->可以看见[side_position]边的一些吟诵者也参与其中，给予支持</li>
    <li>desc_sentence->当[PAWN_nameDef]完成心灵仪式时，空气中闪烁着光芒。</li>
    <li>desc_sentence->背景中的巨石闪闪发光。</li>
    <li>desc_sentence->周围的蜡烛在心灵漩涡中忽明忽暗。</li>
  </PerformedPsychicRitual.rulePack.rulesStrings>
  
</LanguageData>