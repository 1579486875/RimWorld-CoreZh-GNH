<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: spark slave rebellion -->
  <SparkSlaveRebellion.label>引发奴隶叛乱</SparkSlaveRebellion.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef]提议一起逃出去。</li>
    <li>r_logentry->[INITIATOR_nameDef]鼓励[RECIPIENT_nameDef]夺回[RECIPIENT_possessive]自由。</li>
    <li>r_logentry->[INITIATOR_nameDef]谈起终结奴役、一起逃出去。</li>
    <li>r_logentry->[INITIATOR_nameDef]谈起奴役之外的生活，鼓励[RECIPIENT_nameDef]逃跑。</li>
    <li>r_logentry->[INITIATOR_nameDef]低声说守卫松懈，现在正是逃跑的好时机。</li>
  -->
  <SparkSlaveRebellion.logRulesInitiator.rulesStrings>
    <li>r_logentry->[INITIATOR_nameDef] 建议他们逃跑。</li>
    <li>r_logentry->[INITIATOR_nameDef] 鼓励[RECIPIENT_nameDef]去夺回[RECIPIENT_possessive]自由。</li>
    <li>r_logentry->[INITIATOR_nameDef] 谈到结束对他们的奴役，闯出一片天地。</li>
    <li>r_logentry->[INITIATOR_nameDef] 谈到了不被奴役的生活并且鼓励[RECIPIENT_nameDef]逃跑。</li>
    <li>r_logentry->[INITIATOR_nameDef] 低声说到，现在安保松懈，是逃跑的最佳时机。</li>
  </SparkSlaveRebellion.logRulesInitiator.rulesStrings>
  
  <!-- EN: suppress -->
  <Suppress.label>镇压</Suppress.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef]告诉[RECIPIENT_nameDef]叛乱会有惩罚。</li>
    <li>r_logentry->[INITIATOR_nameDef]警告[RECIPIENT_nameDef]不服从会受罚。</li>
    <li>r_logentry->[INITIATOR_nameDef]告诫[RECIPIENT_nameDef]不要犯任何过错。</li>
    <li>r_logentry->[INITIATOR_nameDef]建议[RECIPIENT_nameDef]服从命令，不要多问。</li>
  -->
  <Suppress.logRulesInitiator.rulesStrings>
    <li>r_logentry->[INITIATOR_nameDef] 告诉[RECIPIENT_nameDef]叛乱将受到惩罚。</li>
    <li>r_logentry->[INITIATOR_nameDef] 警告[RECIPIENT_nameDef]不顺从的人将会受到惩罚。</li>
    <li>r_logentry->[INITIATOR_nameDef] 警告[RECIPIENT_nameDef]任何违规行为都将失败。</li>
    <li>r_logentry->[INITIATOR_nameDef] 建议[RECIPIENT_nameDef]服从命令，不要多问。</li>
  </Suppress.logRulesInitiator.rulesStrings>
  
</LanguageData>