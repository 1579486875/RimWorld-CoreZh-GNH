<LanguageData>
  
  <!-- EN: advanced psychic rituals -->
  <AdvancedPsychicRituals.label>高级心灵仪式</AdvancedPsychicRituals.label>
  <!-- EN: Perform advanced psychic rituals. -->
  <AdvancedPsychicRituals.description>研究如何举行高级心灵仪式。</AdvancedPsychicRituals.description>
