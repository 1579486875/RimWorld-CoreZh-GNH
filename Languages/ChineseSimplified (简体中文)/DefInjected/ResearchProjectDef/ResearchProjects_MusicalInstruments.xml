<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: harp -->
  <Harp.label>竖琴</Harp.label>
  <!-- EN: Craft the harp, a simple stationary musical instrument popular among nobility in some cultures. -->
  <Harp.description>解锁制作「竖琴」，在某些文化中很受贵族欢迎的一种简易固定乐器。</Harp.description>
  <!-- EN:
    <li>subject->竖琴</li>
    <li>subject->简易弦乐器</li>
    <li>subject_story->在音乐学校受过训练</li>
    <li>subject_story->用蛮荒世界的常见材料做了一把竖琴</li>
    <li>subject_story->为帝国贵族献上过一场竖琴独奏</li>
    <li>subject_story->每天练习滑音</li>
    <li>subject_story->研究过弦乐器使用的文化意义</li>
    <li>subject_gerund->弹奏竖琴</li>
  -->
  <Harp.generalRules.rulesStrings>
    <li>subject->竖琴</li>
    <li>subject->简易弦乐器</li>
    <li>subject_story->曾在音乐学校中受训</li>
    <li>subject_story->用常见的荒野世界材料建造了一个竖琴</li>
    <li>subject_story->独自为帝国贵族弹奏竖琴</li>
    <li>subject_story->每天都练习滑奏</li>
    <li>subject_story->研究了使用弦乐器的文化意义</li>
    <li>subject_gerund->弹奏竖琴</li>
  </Harp.generalRules.rulesStrings>
  
  <!-- EN: harpsichord -->
  <Harpsichord.label>大键琴</Harpsichord.label>
  <!-- EN: Craft the harpsichord, a complex stationary musical instrument. -->
  <Harpsichord.description>制作大键琴，一种复杂的固定乐器。</Harpsichord.description>
  <!-- EN:
    <li>subject->羽管键琴</li>
    <li>subject_story->在核心世界星系引领了一场羽管键琴复兴</li>
    <li>subject_story->在闪耀世界为音乐会演奏用的羽管键琴调音</li>
    <li>subject_story->担任过当地爱乐乐团的羽管键琴首席</li>
    <li>subject_story->制作过专注和声效果的双键盘羽管键琴</li>
    <li>subject_gerund->弹奏羽管键琴</li>
  -->
  <Harpsichord.generalRules.rulesStrings>
    <li>subject->大键琴</li>
    <li>subject_story->引领了核心世界星系的大键琴文艺复兴</li>
    <li>subject_story->为在闪耀世界音乐会上要用到的大键琴校音</li>
    <li>subject_story->担任了当地交响乐团的首席大键琴手</li>
    <li>subject_story->建造的双键大键琴专注于和声</li>
    <li>subject_gerund->弹奏大键琴</li>
  </Harpsichord.generalRules.rulesStrings>
  
  <!-- EN: piano -->
  <Piano.label>钢琴</Piano.label>
  <!-- EN: Craft the piano, an advanced stationary musical instrument. -->
  <Piano.description>制作钢琴，一种先进的固定乐器。</Piano.description>
  <!-- EN:
    <li>subject->钢琴</li>
    <li>subject_story->对弦乐器的完整曲目了然于心</li>
    <li>subject_story->加入过一所音乐学院，那里的学生学作曲家和学钢琴本身一样多</li>
    <li>subject_story->在核心世界之间运输钢琴</li>
    <li>subject_story->记录过好几位钢琴大师的技法</li>
    <li>subject_story->造过一台古怪的钢琴</li>
    <li>subject_gerund->弹奏钢琴</li>
  -->
  <Piano.generalRules.rulesStrings>
    <li>subject->钢琴</li>
    <li>subject_story->了解几乎所有种类的弦乐器</li>
    <li>subject_story->报名参加了一所音乐学院，那里的学生们不仅要弹奏钢琴，还要学习如何作曲</li>
    <li>subject_story->在核心世界间运输钢琴</li>
    <li>subject_story->记录了几名钢琴大家的演奏技术</li>
    <li>subject_story->建造了一架古怪的钢琴</li>
    <li>subject_gerund->弹奏钢琴</li>
  </Piano.generalRules.rulesStrings>
  
</LanguageData>