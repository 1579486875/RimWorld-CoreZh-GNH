<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: archogenetics -->
  <Archogenetics.label>超凡遗传学</Archogenetics.label>
  <!-- EN: Allows a gene assembler to use archite capsules to create seemingly impossible genes. Archite genes and archite capsules can be obtained from traders. -->
  <Archogenetics.description>解锁基因装配器使用超凡胶囊的限制来创造那些看似不可能被创造的基因。超凡基因和超凡胶囊可以通过贸易获取。</Archogenetics.description>
  <!-- EN:
    <li>subject->远古基因学</li>
    <li>subject_story->从超验的伊克斯之月上发掘出远古基因</li>
    <li>subject_story->靠做远古基因生意过得不错</li>
    <li>subject_story->率考察队前往一座远古独石，回来时已经变了个人</li>
    <li>subject_gerund->组装远古基因</li>
    <li>subject_gerund->造出看似不可能的基因</li>
  -->
  <Archogenetics.generalRules.rulesStrings>
    <li>subject->超凡遗传学</li>
    <li>subject_story->从飞升卫星Ix中挖掘出超凡基因</li>
    <li>subject_story->作为超凡基因商人过上美好生活</li>
    <li>subject_story->带领远征研究队前往古老巨石并反馈变化</li>
    <li>subject_gerund->组装超凡基因</li>
    <li>subject_gerund->创造看似不可能的基因</li>
  </Archogenetics.generalRules.rulesStrings>
  
  <!-- EN: deathrest -->
  <Deathrest.label>死眠设备</Deathrest.label>
  <!-- EN: Those with the deathrest gene must periodically undergo a special deathrest coma that lasts several days. This research project allows you to construct buildings which accelerate the deathrest coma and confer specific bonuses on the deathrester. Over time, you can build a grand deathrest temple. -->
  <Deathrest.description>解锁建造可以加速那些拥有死眠基因的人必须定期经历的一种持续数天的死眠进行进度的设备，并给予那些死眠者特定的加成。终有一天，你可以建造出一座宏伟的死眠神庙。</Deathrest.description>
  <!-- EN:
    <li>subject->死眠</li>
    <li>subject_story->解剖死眠神殿中的尸体，终于弄懂了它如何运作</li>
    <li>subject_story->采访过一位仿佛永不衰老的名人，最终探得了她的秘密</li>
    <li>subject_story->试图复现那项技术，结果陷入昏迷，几周后才醒来</li>
    <li>subject_gerund->建造死眠设施</li>
    <li>subject_gerund->改良死眠</li>
  -->
  <Deathrest.generalRules.rulesStrings>
    <li>subject->死眠</li>
    <li>subject_story->解剖死眠神庙中的尸体，并最终了解死眠神庙如何工作</li>
    <li>subject_story->采访一位不受岁月侵扰的名人，并最终了解了她的秘密</li>
    <li>subject_story->试图复制这项技术并陷入昏迷，几周以后才醒来</li>
    <li>subject_gerund->正在建设死眠设备</li>
    <li>subject_gerund->正在改良死眠</li>
  </Deathrest.generalRules.rulesStrings>
  
  <!-- EN: fertility procedures -->
  <FertilityProcedures.label>生育规范</FertilityProcedures.label>
  <!-- EN: Perform the surgeries necessary to create a test tube embryo from a fertile man and woman, then implant the embryo in a surrogate mother or growth vat. Also, perform sterilization surgeries on men and women. -->
  <FertilityProcedures.description>解锁生育相关的手术。从有生育能力的殖民者身上创造出可供代孕或是培育的试管胚胎。以及绝育手术。</FertilityProcedures.description>
  <!-- EN:
    <li>subject->生育手术</li>
    <li>subject_story->用试管胚胎帮核心世界的家庭圆了为人父母之梦</li>
    <li>subject_story->以危险的人工授精技术，把稀有的卡洛皮亚爆炸鼠从灭绝边缘救了回来</li>
    <li>subject_story->用生育干预与培育槽解决了某都市世界的人口危机</li>
    <li>subject_gerund->改变人类生育能力</li>
    <li>subject_gerund->提升或阻断人类生育能力</li>
  -->
  <FertilityProcedures.generalRules.rulesStrings>
    <li>subject->生育规范</li>
    <li>subject_story->帮助核心世界的家庭通过试管婴儿实现父母梦</li>
    <li>subject_story->通过危险的人工授精技术让罕见的卡罗皮亚爆炸鼠免于灭绝</li>
    <li>subject_story->通过生育干预和培育舱解决一个都市世界的人口危机</li>
    <li>subject_gerund->改变人类生育</li>
    <li>subject_gerund->改善或彻底阻断人类生育</li>
  </FertilityProcedures.generalRules.rulesStrings>
  
  <!-- EN: gene processor -->
  <GeneProcessor.label>基因处理器</GeneProcessor.label>
  <!-- EN: Build gene processors, which allow a gene assembler to create xenogerms of higher genetic complexity. -->
  <GeneProcessor.description>一台用于分析处理基因信息的设备。将其放置在基因装配器旁可以增加所能装配的异种胚芽基因复杂度的上限。建造多个基因处理器可进一步提高异种胚芽基因复杂度的上限。</GeneProcessor.description>
  <!-- EN:
    <li>subject->基因处理器</li>
    <li>subject_story->从一艘漂流的废船中提取出闪耀世界基因</li>
    <li>subject_story->把整个村庄当作原料，只为制出一套高等基因</li>
    <li>subject_story->向一个原始部落植入异种胚质，开始了缓慢的启蒙过程</li>
    <li>subject_gerund->建造基因处理器</li>
    <li>subject_gerund->处理基因</li>
  -->
  <GeneProcessor.generalRules.rulesStrings>
    <li>subject->基因处理器</li>
    <li>subject_story->从废弃结构中提取闪耀世界基因</li>
    <li>subject_story->提取整个村庄的基因来创建一套异种基因</li>
    <li>subject_story->通过向一个原始部落的居民植入异种胚芽开启缓慢的进化进程</li>
    <li>subject_gerund->建造基因处理器</li>
    <li>subject_gerund->装配基因</li>
  </GeneProcessor.generalRules.rulesStrings>
  
  <!-- EN: growth vats -->
  <GrowthVats.label>培育舱</GrowthVats.label>
  <!-- EN: Construct growth vats which can gestate an embryo or accelerate a child's growth. -->
  <GrowthVats.description>解锁建造「培育舱」，它可以培育胚胎或加速儿童生长。</GrowthVats.description>
  <!-- EN:
    <li>subject->高级妊娠</li>
    <li>subject->人工子宫</li>
    <li>subject_story->经营一家克隆设施，为核心世界供应仆役</li>
    <li>subject_story->为一个战争世界的军政府造出了一支新军队</li>
    <li>subject_story->帮助各种出身的家庭生儿育女</li>
    <li>subject_gerund->在人工子宫中孕育胚胎</li>
    <li>subject_gerund->加速人类生长</li>
    <li>subject_gerund->建造培育槽</li>
  -->
  <GrowthVats.generalRules.rulesStrings>
    <li>subject->先进妊娠</li>
    <li>subject->人造子宫</li>
    <li>subject_story->建立克隆工厂来为核心世界提供仆从</li>
    <li>subject_story->为战争世界的军政府建立军队</li>
    <li>subject_story->帮助一切出身的家庭拥有孩子</li>
    <li>subject_gerund->在人造子宫中孕育胚胎</li>
    <li>subject_gerund->加速人类发育</li>
    <li>subject_gerund->建造培育舱</li>
  </GrowthVats.generalRules.rulesStrings>
  
  <!-- EN: toxin filtration -->
  <ToxFiltration.label>滤毒器</ToxFiltration.label>
  <!-- EN: Craft and install bionic organs that can filter out toxins from the environment and from enemy attacks. -->
  <ToxFiltration.description>解锁制作可以过滤来自攻击或环境的毒素侵害的仿生器官。</ToxFiltration.description>
  <!-- EN:
    <li>subject->毒素过滤</li>
    <li>subject->毒素代谢</li>
    <li>subject_story->帮助军事世界的战斗幸存者重新呼吸</li>
    <li>subject_story->翘掉化学实验课，去多上伦理课</li>
    <li>subject_story->以过滤专家的身份加入一家矿业公司</li>
    <li>subject_gerund->代谢毒素</li>
    <li>subject_gerund->制作解毒器官</li>
  -->
  <ToxFiltration.generalRules.rulesStrings>
    <li>subject->毒气过滤</li>
    <li>subject->毒气代谢</li>
    <li>subject_story->令中寰世界战斗幸存者再度自主呼吸</li>
    <li>subject_story->为了额外伦理课程跳过化学实践</li>
    <li>subject_story->作为滤毒专家加入矿业公司</li>
    <li>subject_gerund->代谢毒气</li>
    <li>subject_gerund->制作抗毒器官</li>
  </ToxFiltration.generalRules.rulesStrings>
  
  <!-- EN: tox gas -->
  <ToxGas.label>毒气</ToxGas.label>
  <!-- EN: Produce weapons that utilize caustic tox gas. -->
  <ToxGas.description>解锁制作利用化学腐蚀性毒气制成的武器。</ToxGas.description>
  <!-- EN:
    <li>subject->毒气武器</li>
    <li>subject->化学战</li>
    <li>subject_story->梦想造出一件终结一切战争的武器</li>
    <li>subject_story->翘掉伦理课，去多做化学练习</li>
    <li>subject_story->为某个死亡世界的僭主政权研究云层控制技术</li>
    <li>subject_gerund->制作毒气武器</li>
  -->
  <ToxGas.generalRules.rulesStrings>
    <li>subject->毒气武器</li>
    <li>subject->化学战争</li>
    <li>subject_story->梦想结束一切战争的武器</li>
    <li>subject_story->为了化学实践跳过伦理课程</li>
    <li>subject_story->为死亡世界的独裁政府研究云雨控制技术</li>
    <li>subject_gerund->制作毒气武器</li>
  </ToxGas.generalRules.rulesStrings>
  
  <!-- EN: toxifier generator -->
  <ToxifierGenerator.label>排污发电机</ToxifierGenerator.label>
  <!-- EN: Create toxifier generators which generate electricity, but also spread pollution around themselves. -->
  <ToxifierGenerator.description>一种在产电时会非常缓慢地污染它周围半径内地格的发电机。如果半径内的所有地格都已受到污染，这种发电机就会停止运作。</ToxifierGenerator.description>
  <!-- EN:
    <li>subject->毒素发电机</li>
    <li>subject_story->率清理队前往一颗有毒的小行星体</li>
    <li>subject_story->在天裂者的深底污水坑里摸清了毒素机</li>
    <li>subject_story->为一家都市公司研究廉价又脏的能源</li>
    <li>subject_gerund->建造毒素发电机</li>
  -->
  <ToxifierGenerator.generalRules.rulesStrings>
    <li>subject->污染性发电</li>
    <li>subject_story->带领清理人员前往充满毒气的小行星</li>
    <li>subject_story->了解开天者深水池中的有毒生物</li>
    <li>subject_story->为都市企业研究廉价肮脏能源</li>
    <li>subject_gerund->建造污染发生器</li>
  </ToxifierGenerator.generalRules.rulesStrings>
  
  <!-- EN: xenogenetics -->
  <Xenogermination.label>异种遗传学</Xenogermination.label>
  <!-- EN: Create xenogerms which can be implanted in a person to genetically modify them. Extract genepacks from living people using a gene extractor so you can reimplant their genes into someone else. -->
  <Xenogermination.description>解锁制作可以通过植入人体进行基因改造的异种胚芽。用基因提取器从活人身上提取基因组，这样你就可以把他们的基因移植到别人身上。</Xenogermination.description>
  <!-- EN:
    <li>subject->异种胚质植入</li>
    <li>subject->基因植入</li>
    <li>subject_story->被一家专助基因弱势者的闪耀世界慈善机构扶助过</li>
    <li>subject_story->[ANYPAWN_possessive]基因被一个无良生物学家盗走了</li>
    <li>subject_story->为闪耀世界精英经营一家基因转移诊所</li>
    <li>subject_gerund->制作异种胚质</li>
  -->
  <Xenogermination.generalRules.rulesStrings>
    <li>subject->异种胚芽</li>
    <li>subject->基因植入</li>
    <li>subject_story->得到关注基因弱势的闪耀世界慈善机构的支持</li>
    <li>subject_story->被无赖生物学家窃取[ANYPAWN_possessive]基因</li>
    <li>subject_story->开设为闪耀世界精英进行基因改造的诊所</li>
    <li>subject_gerund->制作异种胚芽</li>
  </Xenogermination.generalRules.rulesStrings>
  
</LanguageData>