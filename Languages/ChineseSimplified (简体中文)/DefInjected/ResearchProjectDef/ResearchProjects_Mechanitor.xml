<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: basic mechtech -->
  <BasicMechtech.label>基础机械科技</BasicMechtech.label>
  <!-- EN: The technology needed for your mechanitor to create and control basic-tier mechanoids. -->
  <BasicMechtech.description>解锁机械师需要的技术来制造和控制基础机械族。</BasicMechtech.description>
  <!-- EN:
    <li>subject->机械体</li>
    <li>subject_story->写过多本介绍机械体基本类型的儿童读物</li>
    <li>subject_story->被植入了一枚原型机械链接器</li>
    <li>subject_story->独立复现了基础的生物机械技术</li>
    <li>subject_story->在开采一艘远古外行者的残骸时，发现了一枚完好保存在残骸中的机械链接器</li>
    <li>subject_gerund->创造基础机械体</li>
  -->
  <BasicMechtech.generalRules.rulesStrings>
    <li>subject->机械族</li>
    <li>subject_story->出版介绍机械族基础种类的幼儿书</li>
    <li>subject_story->植入原型机控中枢</li>
    <li>subject_story->独立逆向工程基础机械族技术</li>
    <li>subject_story->挖掘远古重炮机兽残骸并在其中发现机控中枢</li>
    <li>subject_gerund->制作基础机械族</li>
  </BasicMechtech.generalRules.rulesStrings>
  
  <!-- EN: high mechtech -->
  <HighMechtech.label>高级机械科技</HighMechtech.label>
  <!-- EN: The technology needed for your mechanitor to create and control high-tier mechanoids.\n\nYou can get powerfocus chips by using a mechanitor to summon a war queen threat. -->
  <HighMechtech.description>解锁机械师需要的技术来制造和控制高级机械族。\n\n你可以通过让机械师召唤一个战争女皇并击败它以获得能量汇聚芯片。</HighMechtech.description>
  <!-- EN:
    <li>subject->高阶机械体</li>
    <li>subject_story->在一场针对帝国世界的「战争女王」进攻中幸存</li>
    <li>subject_story->从一位不识货的商人手里买下了一枚聚能芯片</li>
    <li>subject_story->审问过在行星突袭中俘获的机械师</li>
    <li>subject_story->为一位外星客户制造过原型机械体微型器官</li>
    <li>subject_gerund->创造高阶机械体</li>
  -->
  <HighMechtech.generalRules.rulesStrings>
    <li>subject->高级机械族</li>
    <li>subject_story->在战争女皇对帝国世界的袭击中幸存</li>
    <li>subject_story->从一个不了解其价值的商人那里购入能量汇聚芯片</li>
    <li>subject_story->在星球袭击的过程中逮捕并审问了一名机械师</li>
    <li>subject_story->为底层世界诊所构建机械族纳米器官原型</li>
    <li>subject_gerund->制造高级机械族</li>
  </HighMechtech.generalRules.rulesStrings>
  
  <!-- EN: standard mechtech -->
  <StandardMechtech.label>标准机械科技</StandardMechtech.label>
  <!-- EN: The technology needed for your mechanitor to create and control standard-tier mechanoids.\n\nYou can get signal chips by using a mechanitor to summon a diabolus threat. -->
  <StandardMechtech.description>解锁机械师需要的技术来制造和控制标准机械族。\n\n你可以通过让机械师召唤一个炼狱魔王并击败它以获得同步信号芯片。</StandardMechtech.description>
  <!-- EN:
    <li>subject->机械体</li>
    <li>subject_story->在不太光彩的情形下弄到了一枚信号芯片</li>
    <li>subject_story->在一艘恶魔的残骸中找到了一枚完好的信号芯片</li>
    <li>subject_story->在一场机械巢群的进攻中幸存</li>
    <li>subject_story->整理机械体袭击的报告，寻找共性</li>
    <li>subject_gerund->创造标准机械体</li>
  -->
  <StandardMechtech.generalRules.rulesStrings>
    <li>subject->机械族</li>
    <li>subject_story->在非正当情况下获得同步信号芯片</li>
    <li>subject_story->在炼狱魔王中发现了完整的同步信号芯片</li>
    <li>subject_story->于机械主巢袭击中幸存</li>
    <li>subject_story->收集机械族袭击报告，寻找共性</li>
    <li>subject_gerund->制造标准机械族</li>
  </StandardMechtech.generalRules.rulesStrings>
  
  <!-- EN: ultra mechtech -->
  <UltraMechtech.label>极致机械科技</UltraMechtech.label>
  <!-- EN: The advanced technology needed for your mechanitor to create and control ultra-tier mechanoids, including large mechs and ultra-tier mechanitor gear.\n\nYou can get nano structuring chips by using a mechanitor to summon an apocriton threat. -->
  <UltraMechtech.description>解锁机械师需要的技术来制造和控制极致机械族，以及制造大型机械与极致机械师装备。\n\n你可以通过让机械师召唤一个憎恶毒蜂并击败它以获得纳米结构芯片。</UltraMechtech.description>
  <!-- EN:
    <li>subject->超级机械体</li>
    <li>subject_story->在死寂世界的残骸中发现了一台断电的「天启者」</li>
    <li>subject_story->从安全距离观察到「天启者」复活机械体</li>
    <li>subject_story->窥探到「天启者」对人类那种深层的灵能恨意</li>
    <li>subject_story->在一座沉寂的远古枢纽旁找到了一本飞升日记</li>
    <li>subject_gerund->创造超级机械体</li>
  -->
  <UltraMechtech.generalRules.rulesStrings>
    <li>subject->极致机械族</li>
    <li>subject_story->在一个死寂世界的残骸中发现了一只休眠的憎恶毒蜂</li>
    <li>subject_story->在安全距离观察复活机械族的憎恶毒蜂</li>
    <li>subject_story->挖掘了憎恶毒蜂对人类内心深处的深深憎恶</li>
    <li>subject_story->在休眠的超凡枢纽旁发现一本飞升日志</li>
    <li>subject_gerund->制造极致机械族</li>
  </UltraMechtech.generalRules.rulesStrings>
  
  <!-- EN: wastepack atomizer -->
  <WastepackAtomizer.label>垃圾分解器</WastepackAtomizer.label>
  <!-- EN: Build wastepack atomizers which can safely dispose of toxic wastepacks by decomposing them at the molecular level. -->
  <WastepackAtomizer.description>一种能在分子层面安全的有毒垃圾分解并将其催化成惰性气体排放的闪耀科技设备。工作过程中需要耗费相当多的电力。</WastepackAtomizer.description>
  <!-- EN:
    <li>subject->有毒废料雾化</li>
    <li>subject_story->研究过安全的原子废料处置</li>
    <li>subject_story->为太阳废料处置任务招募过一次性队伍</li>
    <li>subject_story->从第一性原理推导出了原子失稳理论</li>
    <li>subject_story->从轨道观察过一颗毒化世界</li>
    <li>subject_gerund->建造废料包雾化器</li>
  -->
  <WastepackAtomizer.generalRules.rulesStrings>
    <li>subject->有毒垃圾分解</li>
    <li>subject_story->研究安全核废料处理</li>
    <li>subject_story->为太阳能废料处理任务招募一支灵活的队伍</li>
    <li>subject_story->根据第一性原理设计了原子不稳定理论</li>
    <li>subject_story->从轨道上观测一个剧毒世界</li>
    <li>subject_gerund->建造垃圾分解器</li>
  </WastepackAtomizer.generalRules.rulesStrings>
  
</LanguageData>