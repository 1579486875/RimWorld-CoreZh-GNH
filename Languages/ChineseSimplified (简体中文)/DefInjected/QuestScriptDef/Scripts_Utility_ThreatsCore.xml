<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: <rulesStrings><li>root(priority=1,sitePart==ClimateAdjuster)->那里有(*Threat)一台气候调节机(/Threat)，正把区域温度偏移 [temperatureOffset]</li><li>root(priority=1,sitePart==PsychicDroner)->那里有(*Threat)一台灵能低鸣机(/Threat)，调谐指向[affectedGender]</li><li>root(priority=1,sitePart==PsychicSuppressor)->那里有(*Threat)一台灵能压制机(/Threat)，调谐指向[affectedGender]</li><li>root(priority=1,sitePart==WeatherController)->那里有(*Threat)一台天气控制机(/Threat)，正把整个区域的天气强制为[weather_label]</li><li>root(priority=1,sitePart==SmokeSpewer)->那里有(*Threat)一台喷烟机(/Threat)，正朝整个区域喷吐浓烟</li><li>root(priority=1,sitePart==SunBlocker)->那里有(*Threat)一台遮日机(/Threat)，正把整个区域笼罩在阴影里</li><li>root(priority=1,sitePart==EMIDynamo)->那里有(*Threat)一台电磁脉冲发电机(/Threat)，能让整个区域的电气设备停摆</li><li>root(priority=1,sitePart==ToxicSpewer)->那里有(*Threat)一台喷毒机(/Threat)，正用毒物覆盖整个区域</li><li>root(priority=1,sitePart==RaidSource)->那里有一处军事集结地，由(*Threat)[enemiesCount] 名[enemiesLabel](/Threat)守卫，每隔 [mtbDays] 就会向你发动袭击</li><li>root(priority=1,sitePart==Outpost)->该地点有一处敌方前哨，由(*Threat)[enemiesCount] 名[enemiesLabel](/Threat)守卫</li><li>root(priority=1,sitePart==BanditCamp)->该地点有一处匪徒营地，由(*Threat)[enemiesCount] 名[enemiesLabel](/Threat)守卫</li><li>root(priority=1,sitePart==Manhunters,count==1)->(*Threat)一只陷入猎杀状态的[kindLabel](/Threat)正在附近游荡</li><li>root(priority=1,sitePart==Manhunters,count>1)->(*Threat)[count] 只陷入猎杀状态的[kindLabel](/Threat)正在附近游荡</li><li>root(priority=1,sitePart==SleepingMechanoids,count==1)->(*Threat)一台机械体(/Threat)正在附近沉睡</li><li>root(priority=1,sitePart==SleepingMechanoids,count>1)->(*Threat)[count] 台机械体(/Threat)正在附近沉睡</li><li>root(priority=1,sitePart==Turrets)->(*Threat)[threatsInfo](/Threat)守卫着该地点</li><li>root(priority=1,sitePart==AmbushEdge)->(*Threat)一支敌军(/Threat)正等着伏击任何靠近的人</li><li>root(priority=1,sitePart==AmbushHidden)->(*Threat)一支敌军(/Threat)正等着伏击任何靠近的人</li><li>root(priority=1,sitePart==MechCluster)->那里有(*Threat)一片敌意机械结构集群(/Threat)</li><li>root(priority=1,sitePart==PossibleUnknownThreatMarker)->那里可能有(*Threat)未知威胁(/Threat)</li><li>root->那里有一处[label]</li></rulesStrings> -->
  <Util_GenerateSite.root.singleSitePartRules.slateRef>
    <rulesStrings>
      <li>root(priority=1,sitePart==ClimateAdjuster)->一台可以将温度调整[temperatureOffset]的(*Threat)气候调节器(/Threat)</li>
      <li>root(priority=1,sitePart==PsychicDroner)->一台仅对[affectedGender]起效的(*Threat)心灵放射器(/Threat)</li>
      <li>root(priority=1,sitePart==PsychicSuppressor)->一台仅对[affectedGender]起效的(*Threat)心灵抑制器(/Threat)</li>
      <li>root(priority=1,sitePart==WeatherController)->一台会将整个区域的天气改变为[weather_label]的(*Threat)气象仪(/Threat)</li>
      <li>root(priority=1,sitePart==SmokeSpewer)->一台会持续喷射大量烟雾的(*Threat)烟雾产生器(/Threat)</li>
      <li>root(priority=1,sitePart==SunBlocker)->一台会使整个区域陷入黑暗的(*Threat)黑幕产生器(/Threat)</li>
      <li>root(priority=1,sitePart==EMIDynamo)->一台会瘫痪整个区域的电力设备的(*Threat)电磁干扰器(/Threat)</li>
      <li>root(priority=1,sitePart==ToxicSpewer)->一台会持续释放大量毒雾的(*Threat)空气污染器(/Threat)</li>
      <li>root(priority=1,sitePart==RaidSource)->(*Threat)一块被[enemiesCount]名敌人防守的军事集结区(/Threat)，他们每[mtbDays]就会对你发起袭击</li>
      <li>root(priority=1,sitePart==Outpost)->(*Threat)一个被[enemiesCount]名敌人防守的哨站(/Threat)</li>
      <li>root(priority=1,sitePart==BanditCamp)->(*Threat)匪徒营地(/Threat)内共有[enemiesCount]名敌人</li>
      <li>root(priority=1,sitePart==Manhunters,count==1)->(*Threat)1只猎杀人类的[kindLabel](/Threat)</li>
      <li>root(priority=1,sitePart==Manhunters,count>1)->(*Threat)[count]只猎杀人类的[kindLabel](/Threat)</li>
      <li>root(priority=1,sitePart==SleepingMechanoids,count==1)->(*Threat)1台处于休眠状态的机械族(/Threat)</li>
      <li>root(priority=1,sitePart==SleepingMechanoids,count>1)->(*Threat)[count]台处于休眠状态的机械族(/Threat)</li>
      <li>root(priority=1,sitePart==Turrets)->(*Threat)一支由[threatsInfo]组成的守卫队(/Threat)</li>
      <li>root(priority=1,sitePart==AmbushEdge)->(*Threat)一支埋伏起来的敌军(/Threat)</li>
      <li>root(priority=1,sitePart==AmbushHidden)->(*Threat)一支埋伏起来的敌军(/Threat)</li>
      <li>root(priority=1,sitePart==MechCluster)->(*Threat)一个机械集群(/Threat)</li>
      <li>root(priority=1,sitePart==PossibleUnknownThreatMarker)->(*Threat)未知的威胁(/Threat)</li>
      <li>root->有个[label]</li>
    </rulesStrings>
  </Util_GenerateSite.root.singleSitePartRules.slateRef>
  
  <!-- EN:
    <li>threatDescription->一座机械集群将在[map_definite]降落，其中包含：\n\n[allThreats]</li>
  -->
  <Util_MechCluster.questDescriptionRules.rulesStrings>
    <li>threatDescription->一个机械集群将会空降至[map_definite]。其中包括：\n\n[allThreats]</li>
  </Util_MechCluster.questDescriptionRules.rulesStrings>
  
  <!-- EN:
    <li>threatDescription->来自[enemyFaction_name]的[enemyFaction_pawnsPlural]将攻击你。其队伍由以下构成：\n\n[raidPawnKinds]\n\n[raidArrivalModeInfo]</li>
  -->
  <Util_Raid.questDescriptionRules.rulesStrings>
    <li>threatDescription->来自[enemyFaction_name]的[enemyFaction_pawnsPlural]将会攻击你。他们的组成为：\n\n[raidPawnKinds]\n\n[raidArrivalModeInfo]</li>
  </Util_Raid.questDescriptionRules.rulesStrings>
  
  <!-- EN:
    <li>pawnKindsParagraph(raidCount==1)->这支[enemyFaction_pawnsPlural]队伍由以下构成：\n\n[raid0/raidPawnKinds]\n\n[raid0/raidArrivalModeInfo]</li>
    <li>pawnKindsParagraph(raidCount==2)->第一批[enemyFaction_pawnsPlural]由以下构成：\n\n[raid0/raidPawnKinds]\n\n规模相近的第二批随后就到。</li>
    <li>pawnKindsParagraph(raidCount==3)->第一批[enemyFaction_pawnsPlural]由以下构成：\n\n[raid0/raidPawnKinds]\n\n规模相近的两批随后就到。</li>
    <li>pawnKindsParagraph(raidCount>=4)->第一批[enemyFaction_pawnsPlural]由以下构成：\n\n[raid0/raidPawnKinds]\n\n另有 [raidCountMinusOne] 批规模相近的队伍随后就到。</li>
    <li>numGroupsOf(raidCount==1)-></li>
    <li>numGroupsOf(raidCount==2)->两批</li>
    <li>numGroupsOf(raidCount==3)->三批</li>
    <li>numGroupsOf(raidCount>=4)->[raidCount] 批</li>
  -->
  <Util_RaidDelayRepeatable.questDescriptionRules.rulesStrings>
    <li>pawnKindsParagraph(raidCount==1)->这组[enemyFaction_pawnsPlural]的构成为： \n\n[raid0/raidPawnKinds]\n\n[raid0/raidArrivalModeInfo]</li>
    <li>pawnKindsParagraph(raidCount==2)->第一组[enemyFaction_pawnsPlural]的构成为： \n\n[raid0/raidPawnKinds]\n\n第二支规模相仿的部队即将到来。</li>
    <li>pawnKindsParagraph(raidCount==3)->第一组[enemyFaction_pawnsPlural]的构成为： \n\n[raid0/raidPawnKinds]\n\n两支规模相仿的部队即将到来。</li>
    <li>pawnKindsParagraph(raidCount>=4)->第一组[enemyFaction_pawnsPlural]的构成为： \n\n[raid0/raidPawnKinds]\n\n[raidCountMinusOne]支规模相仿的部队即将到来。</li>
    <li>numGroupsOf(raidCount==1)-></li>
    <li>numGroupsOf(raidCount==2)->两组</li>
    <li>numGroupsOf(raidCount==3)->三组</li>
    <li>numGroupsOf(raidCount>=4)->[raidCount]组</li>
  </Util_RaidDelayRepeatable.questDescriptionRules.rulesStrings>
  
</LanguageData>