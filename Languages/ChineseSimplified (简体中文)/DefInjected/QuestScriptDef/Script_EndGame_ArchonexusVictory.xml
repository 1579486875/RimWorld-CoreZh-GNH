  <EndGame_ArchonexusVictory_ThirdCycle.questDescriptionRules.rulesStrings>
    <li>questDescription-></li>
  </EndGame_ArchonexusVictory_ThirdCycle.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->远古枢纽</li>
  -->
  <EndGame_ArchonexusVictory_ThirdCycle.questNameRules.rulesStrings>
    <li>questName->超凡枢纽</li>
  </EndGame_ArchonexusVictory_ThirdCycle.questNameRules.rulesStrings>
  
</LanguageData>